set_property PACKAGE_PIN B6 [get_ports clk_50mhz]
set_property PACKAGE_PIN K4 [get_ports rst_p]
set_property PACKAGE_PIN N8 [get_ports btn_high]
set_property PACKAGE_PIN N4 [get_ports btn_low]
set_property PACKAGE_PIN F8 [get_ports test_pin]
set_property PACKAGE_PIN N5 [get_ports led_run]
set_property IOSTANDARD LVCMOS33 [get_ports *]
create_clock -name clk_50mhz -period 20.000 [get_ports clk_50mhz]
set_false_path -from [get_ports {rst_p btn_high btn_low}]
